+
+const NotesModal = ({
+  isNotesModalOpen,
+  setIsNotesModalOpen,
+  voucher,
+  setVoucher,
+  isEditing,
+  textAlign,
+}: {
+  isNotesModalOpen: boolean;
+  setIsNotesModalOpen: (value: boolean) => void;
+  voucher: Voucher;
+  setVoucher: Dispatch<SetStateAction<Voucher>>;
