+import { memo } from "react";
+import { useTranslations } from "next-intl";
+
+import { RiyalIcon } from "@/components/RiyalIcon";
+import { formatAmount } from "@/utilities/formatAmount";
+
+interface TotalBalanceProps {
+  totals: {
+    totalDebit: number;
+    totalCredit: number;
+    totalDebitG: number;
