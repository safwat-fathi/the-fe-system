+              disabled={!isEditing}
+              id="voucher-type"
+              ref={
+                registerField(
+                  3,
+                ) as unknown as React.RefObject<HTMLSelectElement>
+              }
+              value={voucher.vouch_type || 2}
+              onChange={(e) =>
