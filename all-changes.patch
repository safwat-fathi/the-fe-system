+}
+
+const TableAsyncSelect = <T extends OptionType>({
+  isEditing,
+  loadOptions,
+  placeholder,
+  value,
+  onChange,
+}: TableAsyncSelectProps<T>) => {
+  return (
+    <AsyncCreatableSelect
+      isClearable
+      isSearchable
+      cacheOptions
+      defaultOptions
+      className="text-xs"
