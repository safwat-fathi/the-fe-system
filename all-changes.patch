+                  onRemoveRow={removeGoldDetailRow}
+                  updateGoldDetail={updateGoldDetail}
+                />
+              ))}
+            </tbody>
+          </table>
+        </div>
+      </div>
+    </div>
+  );
+};
+
+export default memo(GoldTable);
