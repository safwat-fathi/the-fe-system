+          <div className="flex items-center gap-1">
+            <Checkbox
+              color="warning"
+              isDisabled
+              isSelected={voucher.print}
+              size="sm"
+            />
+            <span className="text-xs text-slate-600">
+              {t("status.printed")}
+            </span>
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+};
+
+export default memo(DeliveryHeader);
