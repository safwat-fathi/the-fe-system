+import type { Voucher } from "@/types/voucher";
+import type { Dispatch, SetStateAction } from "react";
+
+import {
+  Modal,
+  ModalContent,
+  ModalHeader,
+  ModalBody,
+  ModalFooter,
+  Button,
+  Textarea,
+} from "@heroui/react";
