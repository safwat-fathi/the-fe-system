echo "Checking types and building the project before pushing..."

echo "⏳ Checking types..."

case `uname` in
  *CYGWIN*|*MINGW*|*MSYS*)
    npm.cmd run type-check
  ;;
  *)
    npm run type-check
  ;;
esac

echo "✅ Type checking passed"

echo "------"
echo "------"

echo "⏳ Building the project..."

case `uname` in
  *CYGWIN*|*MINGW*|*MSYS*)
    npm.cmd run build
  ;;
  *)
    npm run build
  ;;
esac

echo "✅ Build successful"
